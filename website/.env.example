# Copy this file to .env and fill in your credentials.
# Real environment variables take precedence over values in .env.
#
# The site talks to TWO databases:
#   DB_*  MySQL      — accounts, characters, password resets (sql/schema.sql)
#   PG_*  PostgreSQL — the simulation itself, sim.* (sql/schema_pg.sql), written
#                      by scripts/db_spool_loader.py from what the engine spools

# ── Accounts (MySQL) ──────────────────────────────────────────────
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_NAME=ashb2
DB_USER=your_user
DB_PASS=your_password

# ── Simulation (PostgreSQL) ───────────────────────────────────────
# One URL is all it takes, and it is the form hosted providers hand you.
# Keep the sslmode they specify — most managed databases refuse plaintext.
PG_DSN=postgresql://user:password@host.example.com/ashb2?sslmode=require

# ── Supabase ──────────────────────────────────────────────────────
# Supabase offers three connection strings, and the choice is not cosmetic.
#
#  1. Direct           db.<ref>.supabase.co:5432
#     Resolves to an IPv6 address ONLY. Use it only if the machine running the
#     loader has a routable IPv6 address (`ping -6` reaching the internet, not
#     just a ::1 loopback). On an IPv4-only network — most home connections,
#     many CI runners — this fails with "network is unreachable" or a hang,
#     and no configuration here can fix that. Supabase sells an IPv4 add-on.
#
#  2. Session pooler   aws-0-<region>.pooler.supabase.com:5432   <- USE THIS
#     Reachable over IPv4. User is `postgres.<ref>`, not `postgres`.
#     A session is held for the life of the connection, so server-side
#     prepared statements work — which this app requires: sim_db.php sets
#     PDO::ATTR_EMULATE_PREPARES => false.
#
#  3. Transaction pooler   aws-0-<region>.pooler.supabase.com:6543
#     Also IPv4, but a connection is handed back after every transaction, so
#     server-side prepared statements and other session state break. The PHP
#     side above will fail against it. Do not use it for this app.
#
#PG_DSN=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# An IPv6 literal must be bracketed here, exactly as in any URL — the code
# strips the brackets before handing the address to libpq:
#PG_DSN=postgresql://user:password@[2001:db8::1]:5432/ashb2?sslmode=require

# Or the same thing in pieces, used only when PG_DSN is empty.
# PG_HOST takes a bare IPv6 address; brackets are tolerated and stripped.
#PG_HOST=127.0.0.1
#PG_PORT=5432
#PG_NAME=ashb2
#PG_USER=postgres
#PG_PASS=
#PG_SSLMODE=require

# Seconds to wait for the simulation database before giving up on a page.
#PG_TIMEOUT=5
# Which world the site shows — the engine's --world-id.
#SIM_WORLD_ID=1

APP_URL=http://localhost:8080
APP_ENV=development
